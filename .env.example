# Spring Boot datasource
# Local dev connects to the MySQL published by compose.yaml on port 3307.
# On the deployed server this is jdbc:mysql://mysql:3306/jb (docker network host).
DB_URL=jdbc:mysql://localhost:3307/jb
DB_USERNAME=jb-app
DB_PASSWORD=password1

# Server deployment only. Used by compose.prod.yaml to initialise the MySQL root account.
DB_ROOT_PW=root-password

# Google Identity Services
GOOGLE_CLIENT_ID=replace-with-google-client-id

# Generate independent secrets of at least 32 random bytes for each token type.
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
AUTH_REFRESH_TOKEN_SECRET=replace-with-another-at-least-32-random-bytes

# false is allowed only for local HTTP development.
# The deployed backend is served over plain HTTP, so it stays false until the
# frontend proxies /api through its HTTPS origin. Flip to true in that change.
AUTH_COOKIE_SECURE=false

# Comma-separated frontend origins allowed to call credentialed auth endpoints.
# Deployed frontend: https://jb-front.kaameo12.workers.dev
AUTH_ALLOWED_ORIGINS=http://localhost:3000

# VWorld geocoding (address -> WGS84 lat/lng). Free personal key from vworld.kr.
VWORLD_API_KEY=replace-with-vworld-api-key
